      "threads": {
        "thread-time": {
          "id": "thread-time",
          "title": "时刻表",
          "order": 0,
          "goal": "确定周慕青最后一次被他人证实的准确时刻，把当夜的时间窗收窄成可核对的一段。",
          "obstacle": "修表铺里的钟全部停摆，其中一只被人为拨过；每个证人的时间都来自各自的手机或家电，无法互相对照。",
          "intended_resolution": "用楼道里的声音重演与铺子定时灯被拨的时刻，把互相排斥的证词压成一段可核对的时间。"
        },
        "thread-traces": {
          "id": "thread-traces",
          "title": "痕迹",
          "order": 1,
          "goal": "用院子雪地与楼道的痕迹还原当夜进出的次数与路线。",
          "obstacle": "屋檐下与空地上的雪面结得不一样，脚印深浅不能据以判断负重、人数或搬过什么；痕迹只能证明有人走过，不能证明是谁。",
          "intended_resolution": "把痕迹能成立的时段与另两线的时间窗比对，只保留能同时成立的走法，其余留作待证。"
        },
        "thread-knowledge": {
          "id": "thread-knowledge",
          "title": "知情范围",
          "order": 2,
          "goal": "查清谁知道周慕青的作息、铺子晚上不收门的习惯和灯的用法。",
          "obstacle": "每个被问到的人都说与他只是点头之交，彼此的说法又互相掩护；修理登记簿上最后一笔客户名被人划掉。",
          "intended_resolution": "顺着被划掉的名字找到替人捎表的中间人，把知情范围从楼内扩到楼外，再与另两线的时间窗对照。"
        }
