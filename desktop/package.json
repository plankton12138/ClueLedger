{
  "name": "hastings-desktop",
  "version": "0.3.0",
  "private": true,
  "description": "Hastings 桌面端：Electron 壳 + sidecar 生命周期",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win --x64"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.0"
  },
  "build": {
    "appId": "com.hastings.desktop",
    "productName": "Hastings",
    "files": [
      "dist/**/*",
      "error.html"
    ],
    "extraResources": [
      {
        "from": "../build-resources/sidecar/hastings-server.exe",
        "to": "sidecar/hastings-server.exe"
      },
      {
        "from": "../frontend/dist",
        "to": "frontend-dist"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Hastings-Setup-${version}.exe"
    }
  }
}
