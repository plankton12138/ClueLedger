# Hastings 环境变量模板——复制为 .env 并填入真实值（.env 已被 git 忽略）

# OpenAI 兼容端点的 API Key（必填）
OPENAI_API_KEY=

# OpenAI 兼容端点地址（可选，默认 https://api.openai.com/v1）
# 国内兼容端点示例：
#   DeepSeek:  https://api.deepseek.com/v1
#   智谱 GLM:  https://open.bigmodel.cn/api/paas/v4
#   通义 Qwen: https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_BASE_URL=

# 使用的模型名（必填），需与上方端点匹配
# 示例：deepseek-chat / glm-4-plus / qwen-plus / gpt-4o-mini
HASTINGS_MODEL=
