# /etc/cluleledger/server.env
# chmod 600；属主 root:clueledger。不要提交到仓库。
CLUELEDGER_ENV=production
CLUELEDGER_MODE=server
CLUELEDGER_DATABASE=/var/lib/cluleledger/clueledger.sqlite3
CLUELEDGER_WORKSPACES_ROOT=/var/lib/cluleledger/workspaces
CLUELEDGER_LIBRARIES_ROOT=/var/lib/cluleledger/libraries
CLUELEDGER_CREDENTIAL_KEY_FILE=/etc/cluleledger/credential.key
CLUELEDGER_CREDENTIALS_FILE=/var/lib/cluleledger/credentials.vault
CLUELEDGER_PUBLIC_BASE_URL=https://clue.example.com
CLUELEDGER_ALLOWED_ORIGINS=https://clue.example.com
CLUELEDGER_BILLING_URL=http://127.0.0.1:8300
CLUELEDGER_BILLING_INTERNAL_SECRET_FILE=/etc/cluleledger/billing-internal.secret
CLUELEDGER_PLATFORM_MODELS=deepseek-v4-pro,deepseek-flash
CLUELEDGER_TRUST_PROXY=1
CLUELEDGER_LOG_JSON=1

CLUELEDGER_SMTP_HOST=smtp.example.com
CLUELEDGER_SMTP_PORT=587
CLUELEDGER_SMTP_USERNAME=clueledger
CLUELEDGER_SMTP_FROM=no-reply@clue.example.com
CLUELEDGER_SMTP_PASSWORD_FILE=/etc/cluleledger/smtp.password
