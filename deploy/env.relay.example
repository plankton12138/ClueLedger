# /etc/cluleledger/relay.env
# chmod 600；属主 root:clueledger。不要提交到仓库。
RELAY_ENV=production
RELAY_DB_PATH=/var/lib/cluleledger/clueledger.sqlite3
RELAY_PUBLIC_BASE_URL=https://clue.example.com
RELAY_SITE_URL=https://clue.example.com
RELAY_ALLOWED_ORIGINS=https://clue.example.com
RELAY_RECONCILE_SECONDS=60

ALIPAY_APP_ID=2026000000000000
ALIPAY_APP_PRIVATE_KEY_FILE=/etc/cluleledger/alipay-app-private.pem
ALIPAY_PUBLIC_KEY_FILE=/etc/cluleledger/alipay-public.pem
ALIPAY_SELLER_ID=2088000000000000
ALIPAY_NOTIFY_URL=https://clue.example.com/notify/alipay
ALIPAY_RETURN_URL=https://clue.example.com/return/alipay

RELAY_ADMIN_TOKEN_FILE=/etc/cluleledger/relay-admin.token
RELAY_INTERNAL_SECRET_FILE=/etc/cluleledger/billing-internal.secret

PLATFORM_MODEL_BASE_URL=https://api.deepseek.com/v1
PLATFORM_MODEL_API_KEY_FILE=/etc/cluleledger/platform-model.key
PLATFORM_MODELS=[{"name":"deepseek-v4-pro","multiplier":"1.0","max_output_tokens":131072},{"name":"deepseek-flash","multiplier":"0.30","max_output_tokens":131072}]
PLATFORM_DEFAULT_OUTPUT_TOKENS=4096
RELAY_MAX_CONCURRENT_REQUESTS=2
