[Unit]
Description=ClueLedger writing server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=clueledger
Group=clueledger
WorkingDirectory=/opt/cluleledger
EnvironmentFile=/etc/cluleledger/server.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/cluleledger/.venv/bin/python -m hastings.server --production --mode server --host 127.0.0.1 --port 8000 --state-dir /var/lib/cluleledger/state --static-dir /opt/cluleledger/frontend/dist
Restart=always
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/cluleledger
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
