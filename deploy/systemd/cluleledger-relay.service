[Unit]
Description=ClueLedger billing and subscription proxy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=clueledger
Group=clueledger
WorkingDirectory=/opt/cluleledger
EnvironmentFile=/etc/cluleledger/relay.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/cluleledger/.venv/bin/python -m hastings.relay --production --host 127.0.0.1 --port 8300
Restart=always
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/cluleledger
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
