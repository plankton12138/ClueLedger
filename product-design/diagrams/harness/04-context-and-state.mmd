flowchart LR
    accTitle: 工作者上下文与 0.3 共同背景
    accDescr: 两种上下文均来自作品固定版本；Job 保存任务状态，对话存储保存交流，Harness 不拥有作品事实。
    DB["作品仓库的固定版本<br/>Commit / Revision / 原文 / 账本"]
    subgraph LEGACY["工作者任务上下文"]
        CB["Context Builder<br/>按目标、依赖与预算选择"]
        CP["ContextPackage<br/>输入版本 · 作者要求<br/>目标 / Capability · omissions"]
        WR["一次性工作者 Harness<br/>按能力范围读回遗漏资料"]
        CB --> CP --> WR
    end
    subgraph CURRENT["0.3 共同背景"]
        BG["BackgroundService<br/>按 Commit 收集材料"]
        TIERS["按优先级装配六层<br/>① 本书约定<br/>② 知情与披露边界<br/>③ 故事核心<br/>④ 章节概览<br/>⑤ 目录<br/>⑥ 本次目标"]
        PKG["BackgroundPackage<br/>versions · coverage · omissions<br/>content_hash"]
        DIRECT["对话 / 试写的系统背景<br/>ProviderChatRunner"]
        BG --> TIERS --> PKG --> DIRECT
    end
    DB --> CB
    DB --> BG
    CHAT["对话记录<br/>交流历史与稳定对象 ID<br/>不拥有作品事实或任务授权"] -.-> DIRECT
    JOB["Job 持久状态<br/>输入 / 凭据 / 模型绑定<br/>checkpoint / generation"] -.-> WR
    classDef source fill:#fff4df,stroke:#ae8037,color:#654719;
    classDef work fill:#eaf5f0,stroke:#43836a,color:#173f31;
    classDef bg fill:#edf5ff,stroke:#4677a7,color:#183650;
    class DB,CHAT,JOB source;
    class CB,CP,WR work;
    class BG,TIERS,PKG,DIRECT bg;
