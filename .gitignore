# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
build/
dist/

# 虚拟环境（uv）
.venv/

# 环境变量与密钥
.env
config.yaml

# 编辑器 / 工具本地目录
.trae/
.vscode/
.workbuddy/
.workbuddy-ai/

# 类型检查 / 测试缓存
.mypy_cache/
.pytest_cache/
.ruff_cache/

# 项目产物
stories/
.chroma/
build-resources/

# 注意：uv.lock 不忽略，必须提交（CI 用 --locked 保证权威）

# 原著版权文本不入库：仅提交抽取出走查基准源的三篇 txt
eval/assets/*.epub

# 走查转录属运行产物：入库驱动/规格/报告，不入库逐例终端记录
eval/runs/**/*.log

# Playwright E2E 运行产物（trace/报告属本地调试物，不入库）
frontend/test-results/
frontend/playwright-report/

# data/ 全部是本地运行产物（工作台数据库、服务日志），不入库；备份走 /backup 导出
data/
